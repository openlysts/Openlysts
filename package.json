{
  "name": "openlysts",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.js",
    "dev": "concurrently \"node server/index.js --dev\" \"vite --force\"",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "test": "vitest run tests/services/ && node server/tests/catalog_invariants.test.js && node server/tests/edge_chaos.test.js",
    "test:api": "vitest run tests/api/",
    "db:build-catalogs": "node server/scripts/buildMegaCatalogs.js",
    "db:sync-neon": "node server/scripts/syncNeon.js",
    "audit": "bash scripts/audit/run-all-audits.sh --full",
    "audit:quick": "bash scripts/audit/run-all-audits.sh --quick",
    "audit:security": "bash scripts/audit/security-audit.sh",
    "audit:secrets": "node scripts/audit/secrets-scan.mjs",
    "audit:performance": "bash scripts/audit/performance-audit.sh",
    "audit:quality": "bash scripts/audit/code-quality-audit.sh",
    "audit:deps": "bash scripts/audit/dependency-audit.sh",
    "audit:db": "bash scripts/audit/database-audit.sh",
    "audit:docs": "bash scripts/audit/documentation-audit.sh",
    "audit:post-change": "bash scripts/audit/post-change-trigger.sh",
    "test:e2e": "npx playwright test --reporter=line",
    "test:server": "node scripts/run-server-tests.js server/tests/api-endpoints.test.js server/tests/auth-security.test.js server/tests/db-queries.test.js",
    "test:all": "npm run test:server && npm run test:e2e",
    "test:smoke": "npx playwright test tests/smoke/ --reporter=line",
    "test:regression": "node tests/regression/api-regression.js",
    "test:regression:visual": "npx playwright test tests/regression/visual-regression.spec.js",
    "test:load": "node scripts/load/api-load-test.js",
    "smoke": "node scripts/smoke/post-deploy.js",
    "smoke:prod": "node scripts/smoke/post-deploy.js --prod",
    "monitor:health": "node scripts/monitoring/health-check.js",
    "monitor:errors": "node scripts/monitoring/error-rate.js",
    "monitor:anomaly": "node scripts/monitoring/anomaly-detect.js",
    "report:test": "node scripts/reports/generate-report.js",
    "report:audit": "npm run audit 2>&1 | tee reports/audit-$(date +%Y%m%d).log",
    "sanity": "node scripts/sanity/check-env.js",
    "sanity:db": "node scripts/sanity/check-schema.js",
    "sanity:all": "npm run sanity && npm run sanity:db",
    "launch:check": "node scripts/sanity/launch-readiness.js",
    "rollback": "bash scripts/rollback/rollback.sh production",
    "rollback:staging": "bash scripts/rollback/rollback.sh staging",
    "rollback:dry-run": "bash scripts/rollback/rollback.sh production --dry-run",
    "deploy": "bash scripts/deploy.sh production",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "setup": "bash scripts/setup.sh",
    "db:reset": "bash scripts/db-reset.sh --confirm",
    "db:backup": "bash scripts/backup.sh",
    "audit:lighthouse": "npx lighthouse-ci autorun",
    "audit:accessibility": "bash scripts/audit/a11y-audit.sh",
    "test:unit": "vitest run tests/services/",
    "test:unit:watch": "vitest tests/services/",
    "test:coverage": "vitest run --coverage tests/services/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/mona-sans": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
