# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[*.sql]
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 120
