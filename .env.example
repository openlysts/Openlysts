# Copy to .env.local and fill in — never commit real values.
# The app boots with empty values; features degrade gracefully.

# PostgreSQL/Neon connection (required for persistence)
DATABASE_URL=postgresql://user:pass@host/db

# GitHub token (optional — enables live ingestion)
GITHUB_TOKEN=

# Cloudflare Turnstile (optional — auth captcha)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# SMTP (optional — transactional email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

# Session secret (required for auth)
SESSION_SECRET=

# App URL
APP_URL=http://localhost:5173
