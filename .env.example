# ─────────────────────────────────────────────────────────────────
# Openlysts Environment Variables
# ─────────────────────────────────────────────────────────────────

# --- App Settings ---
# Base URL for OAuth redirects and emails (e.g., http://localhost:5173 for local, https://openlysts.com for prod)
APP_URL=http://localhost:5173

# Comma-separated list of emails that should be automatically granted Admin rights on login
ADMIN_EMAILS=admin@example.com

# --- Database ---
# PostgreSQL connection string (Neon, Supabase, local, etc)
DATABASE_URL=postgres://user:password@localhost:5432/openlysts

# --- Security ---
# Secret key for signing session cookies and OAuth state tokens. MUST BE SET IN PROD.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# --- Authentication Providers ---
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub API (Ingestion & Search) ---
# Personal Access Token used to fetch repository data (requires public_repo scope at minimum)
GITHUB_TOKEN=

# --- Email (SMTP for Password Reset & Contact Form) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Where contact form submissions should be sent
CONTACT_EMAIL=your-email@gmail.com
