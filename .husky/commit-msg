#!/bin/sh
# Commit message validation hook
# Ensures commits follow Conventional Commits format

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Conventional Commits pattern
# type(scope): description
# Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build
pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\(.+\))?: .{1,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Expected format: <type>(<scope>): <description>"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add TOTP two-factor authentication"
  echo "  fix(api): prevent SQL injection in search endpoint"
  echo "  docs(readme): update installation instructions"
  echo "  test(auth): add rate limiting verification tests"
  echo ""
  echo "Your message: $commit_msg"
  echo ""
  exit 1
fi

# Check description length
description=$(echo "$commit_msg" | sed -E 's/^[a-z]+(\([^)]+\))?: //')
if [ ${#description} -gt 72 ]; then
  echo ""
  echo "⚠️  Commit message description is too long (${#description} chars, max 72)"
  echo "   Consider breaking it into multiple lines"
  echo ""
fi
