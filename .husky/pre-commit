#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# GIT PRE-COMMIT HOOK
# Runs code quality + security checks before every commit
# ═══════════════════════════════════════════════════════════════════

echo "Running pre-commit checks..."

# Get changed files
CHANGED_FILES=$(git diff --cached --name-only)

# Only run if JS/JSX/TS files changed
if echo "$CHANGED_FILES" | grep -qE "\.(js|jsx|ts|tsx)$"; then
  echo "  Checking code quality..."

  # ESLint
  if ! npm run lint 2>/dev/null; then
    echo "  ✗ ESLint failed — fix errors before committing"
    exit 1
  fi

  # Check for secrets in staged files
  if echo "$CHANGED_FILES" | xargs grep -l "ghp_\|sk-\|password.*=" 2>/dev/null | grep -v ".env" | head -1; then
    echo "  ✗ Potential secrets detected in staged files"
    exit 1
  fi

  # Check for console.log in staged files
  if echo "$CHANGED_FILES" | xargs grep -l "console\.log" 2>/dev/null | grep -v "test\|debug\|DEV" | head -1; then
    echo "  ⚠ console.log found in staged files (consider removing)"
  fi
fi

# Check if package.json changed
if echo "$CHANGED_FILES" | grep -q "package.json"; then
  echo "  Checking dependencies..."
  if [ -f "package-lock.json" ]; then
    echo "  ✓ package-lock.json exists"
  fi
fi

echo "  ✓ Pre-commit checks passed"
