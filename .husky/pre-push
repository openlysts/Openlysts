#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# GIT PRE-PUSH HOOK
# Runs full audit suite before pushing to remote
# ═══════════════════════════════════════════════════════════════════

echo ""
echo "Running pre-push checks..."

# Run quick audit
SCRIPT_DIR="$(dirname "$0")/.."
if [ -f "$SCRIPT_DIR/scripts/audit/run-all-audits.sh" ]; then
  bash "$SCRIPT_DIR/scripts/audit/run-all-audits.sh" --quick
  EXIT_CODE=$?
  if [ "$EXIT_CODE" -ne 0 ]; then
    echo "✗ Pre-push audit failed — fix issues before pushing"
    echo "  Run: ./scripts/audit/run-all-audits.sh --full"
    exit 1
  fi
fi

# Build verification
echo "Running build verification..."
if ! npm run build 2>/dev/null; then
  echo "✗ Build failed — fix build errors before pushing"
  exit 1
fi

echo "✓ Pre-push checks passed"
